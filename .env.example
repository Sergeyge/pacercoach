# Prototype automatic Garmin sync.
# For production, replace this with Garmin official OAuth API.
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password
# GARMIN_MFA_CODE=123456
AUTO_SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60
TARGET_DISTANCE_KM=35
TRAINING_GOAL=half_marathon_sub_2h
# Required when the app is reachable from the internet. Generate a strong value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it on every request as the header:  X-API-Key: <value>
API_KEY=changeme-generate-a-strong-random-key

# Goal-driven adaptive plan
# OpenAI powers the daily coaching layer. If unset, the daily update falls back
# to the deterministic rule-based engine (still fully functional).
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Each morning at this local time the day's workout is recomputed and (optionally) pushed to Garmin.
MORNING_UPDATE_TIME=06:00
TIMEZONE=Asia/Jerusalem
GOAL_AUTO_PUSH=true

# Morning summary delivery channel: none | callmebot (WhatsApp) | email (Gmail SMTP).
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords — the 16-char password goes in SMTP_PASS.
NOTIFY_CHANNEL=none
# Email (SMTP) — Gmail defaults below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com
# CallMeBot (WhatsApp) — activate by messaging "+34 644 51 95 23" the text
#   "I allow callmebot to send me messages" to get an API key:
# CALLMEBOT_PHONE=9725XXXXXXXX
# CALLMEBOT_APIKEY=123456

# Morning summary notification (today's workout + coaching note).
# NOTIFY_CHANNEL: none | callmebot
# CallMeBot (WhatsApp): on your phone, message "+34 644 51 95 23" the text
#   "I allow callmebot to send me messages" to get your API key, then set:
NOTIFY_CHANNEL=none
# CALLMEBOT_PHONE=9725XXXXXXXX        # your number, international format, no '+'
# CALLMEBOT_APIKEY=123456

# Cloudflare Tunnel token (read by docker-compose.yml at startup; expand into
# the cloudflared run command). Create a named tunnel in the Cloudflare
# dashboard → "Connect a Connector" → copy the long base64-ish token.
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
